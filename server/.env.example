# Copy to .env and run:  node --env-file=.env src/index.js
PORT=8080
DATA_DIR=./data
PUBLIC_URL=https://killswitch.yourcompany.com
# Workflow timing (production: DAY_MS=86400000 = one real day)
DAY_MS=86400000
GRACE_DAYS=10
WIPE_AFTER_LOCK_DAYS=20
LEASE_DAYS=7
REQUIRED_WIPE_APPROVALS=2
WIPE_MAX_PER_HOUR=3
LOCK_MESSAGE=This laptop is company property and has been locked. Please return it to IT: it-support@yourcompany.com
# Optional: override the generated HR webhook secret
# HR_WEBHOOK_SECRET=change-me
